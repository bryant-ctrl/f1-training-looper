   "outputs": [],
   "source": [
    "# Cell 5: Main CFD worker loop — runs until you stop it\n",
    "import datetime\n",
    "\n",
    "POLL_INTERVAL = 20  # seconds between queue checks\n",
    "\n",
    "print(f'CFD Worker ({WORKER_ID}) started at {datetime.datetime.now().strftime(\"%H:%M:%S\")}')\n",
    "print(f'Watching queue: {QUEUE_DIR}')\n",
    "print('Waiting for jobs...\\n')\n",
    "\n",
    "processed = set()  # job IDs already handled this session\n",
    "\n",
    "while True:\n",
    "    job_files = sorted(QUEUE_DIR.glob('*.json'))\n",
    "\n",
    "    for job_file in job_files:\n",
    "        job_id = job_file.stem\n",
    "        if job_id in processed:\n",
    "            continue\n",
    "\n",
    "        # Check the matching STL exists (may still be uploading)\n",
    "        stl_file = QUEUE_DIR / f'{job_id}.stl'\n",
    "        if not stl_file.exists():\n",
    "            continue\n",
    "\n",
    "        print(f'[{datetime.datetime.now().strftime(\"%H:%M:%S\")}] Processing job: {job_id}')\n",
    "        processed.add(job_id)\n",
    "\n",
    "        case_dir = WORK_DIR / job_id\n",
    "        if case_dir.exists():\n",
    "            shutil.rmtree(case_dir)\n",
    "\n",
    "        try:\n",
    "            # Build the case\n",
    "            write_case(case_dir, stl_file)\n",
    "\n",
    "            # Mesh\n",
    "            print('  Running blockMesh...')\n",
    "            out, err, rc = of_run('blockMesh', cwd=case_dir)\n",
    "            if rc != 0:\n",
    "                raise RuntimeError(f'blockMesh failed:\\n{err[-1000:]}')\n",
    "\n",
    "            print('  Running snappyHexMesh...')\n",
    "            out, err, rc = of_run('snappyHexMesh -overwrite', cwd=case_dir)\n",
    "            if rc != 0:\n",
    "                raise RuntimeError(f'snappyHexMesh failed:\\n{err[-1000:]}')\n",
    "\n",
    "            # Solve\n",
    "            print('  Running simpleFoam...')\n",
    "            out, err, rc = of_run('simpleFoam', cwd=case_dir)\n",
    "            if rc != 0:\n",
    "                raise RuntimeError(f'simpleFoam failed:\\n{err[-1000:]}')\n",
    "\n",
    "            # Extract results\n",
    "            results = parse_force_coeffs(case_dir)\n",
    "            results['job_id'] = job_id\n",
    "            results['worker'] = WORKER_ID\n",
    "            results['timestamp'] = datetime.datetime.now().isoformat()\n",
    "\n",
    "            # Write result to Drive\n",
    "            result_file = RESULTS / f'{job_id}.json'\n",
    "            result_file.write_text(json.dumps(results, indent=2))\n",
    "\n",
    "            print(f'  Done! CL={results[\"cl\"]:.4f}  CD={results[\"cd\"]:.4f}  L/D={results[\"score\"]:.3f}')\n",
    "            print(f'  Result written to {result_file.name}')\n",
    "\n",
    "        except Exception as e:\n",
    "            print(f'  ERROR: {e}')\n",
    "            # Write an error result so the orchestrator doesn't wait forever\n",
    "            error_result = {\n",
    "                'job_id': job_id, 'worker': WORKER_ID,\n",
    "                'error': str(e), 'cl': 0.0, 'cd': 1.0, 'score': 0.0,\n",
    "                'timestamp': datetime.datetime.now().isoformat(),\n",
    "            }\n",
    "            (RESULTS / f'{job_id}.json').write_text(json.dumps(error_result, indent=2))\n",
    "\n",
    "        finally:\n",
    "            # Free disk space\n",
    "            if case_dir.exists():\n",
    "                shutil.rmtree(case_dir)\n",
    "\n",
    "    time.sleep(POLL_INTERVAL)"
   ]
  }
 ]
}"
