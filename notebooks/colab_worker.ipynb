   "source": [
    "# F1 CFD Worker — Google Colab\n",
    "\n",
    "This notebook acts as a CFD compute worker. It:\n",
    "1. Mounts your Google Drive\n",
    "2. Installs OpenFOAM (takes ~5 min on first run)\n",
    "3. Watches `f1-opt/queue/` for new mesh jobs\n",
    "4. Runs `simpleFoam` steady-state RANS on each mesh\n",
    "5. Writes CL/CD results to `f1-opt/results/`\n",
    "\n",
    "**Keep this tab open in your browser for the full 12-hour session.**\n",
    "Colab will not disconnect as long as the notebook is actively running."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b2c3d4e5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 1: Mount Google Drive\n",
    "from google.colab import drive\n",
    "drive.mount('/content/drive')\n",
    "print('Drive mounted at /content/drive')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c3d4e5f6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 2: Install OpenFOAM (run once — takes ~5 minutes)\n",
    "# OpenFOAM v2312 is the latest stable as of 2025.\n",
    "import subprocess, sys\n",
    "\n",
    "def run(cmd):\n",
    "    result = subprocess.run(cmd, shell=True, capture_output=True, text=True)\n",
    "    if result.returncode != 0:\n",
    "        print('STDERR:', result.stderr[-2000:])\n",
    "        raise RuntimeError(f'Command failed: {cmd}')\n",
    "    return result.stdout\n",
    "\n",
    "print('Adding OpenFOAM repo...')\n",
    "run('curl -s https://dl.openfoam.com/add-debian-repo.sh | bash')\n",
    "run('apt-get update -qq')\n",
    "print('Installing OpenFOAM (this takes a few minutes)...')\n",
    "run('apt-get install -y -qq openfoam2312')\n",
    "print('OpenFOAM installed.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d4e5f6a7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 3: Setup — paths and OpenFOAM case template\n",
    "import os, json, time, shutil, subprocess\n",
    "from pathlib import Path\n",
    "\n",
    "DRIVE_F1  = Path('/content/drive/MyDrive/f1-opt')\n",
    "QUEUE_DIR = DRIVE_F1 / 'queue'\n",
    "RESULTS   = DRIVE_F1 / 'results'\n",
    "WORK_DIR  = Path('/content/cfd_work')\n",
    "WORKER_ID = 'colab'\n",
    "\n",
    "QUEUE_DIR.mkdir(parents=True, exist_ok=True)\n",
    "RESULTS.mkdir(parents=True, exist_ok=True)\n",
    "WORK_DIR.mkdir(exist_ok=True)\n",
    "\n",
    "OF_BASHRC = '/usr/lib/openfoam/openfoam2312/etc/bashrc'\n",
    "\n",
    "def of_run(cmd, cwd=None):\n",
    "    \"\"\"Run a command with the OpenFOAM environment sourced.\"\"\"\n",
    "    full = f'bash -c \"source {OF_BASHRC} && {cmd}\"'\n",
    "    r = subprocess.run(full, shell=True, capture_output=True, text=True, cwd=cwd)\n",
    "    return r.stdout, r.stderr, r.returncode\n",
    "\n",
    "print(f'Queue: {QUEUE_DIR}')\n",
    "print(f'Results: {RESULTS}')\n",
    "print(f'Worker ID: {WORKER_ID}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e5f6a7b8",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 4: OpenFOAM case setup functions\n",
    "\n",
    "def write_case(case_dir: Path, stl_path: Path):\n",
    "    \"\"\"Write a minimal OpenFOAM simpleFoam case around the given STL.\"\"\"\n",
    "    (case_dir / '0').mkdir(parents=True, exist_ok=True)\n",
    "    (case_dir / 'constant' / 'triSurface').mkdir(parents=True, exist_ok=True)\n",
    "    (case_dir / 'system').mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    # Copy STL into triSurface\n",
    "    shutil.copy2(stl_path, case_dir / 'constant' / 'triSurface' / 'car.stl')\n",
    "\n",
    "    # --- blockMeshDict: domain box (metres) ---\n",
    "    # Car sits at origin, nose pointing in +X direction.\n",
    "    # Domain: 20m upstream, 40m downstream, 10m sides, 8m height.\n",
    "    (case_dir / 'system' / 'blockMeshDict').write_text(\"\"\"\\\n",
    "FoamFile { version 2.0; format ascii; class dictionary; object blockMeshDict; }\n",
    "convertToMeters 1;\n",
    "vertices\n",
    "(\n",
    "    (-20 -10  0)  // 0\n",
    "    ( 40 -10  0)  // 1\n",
    "    ( 40  10  0)  // 2\n",
    "    (-20  10  0)  // 3\n",
    "    (-20 -10  8)  // 4\n",
    "    ( 40 -10  8)  // 5\n",
    "    ( 40  10  8)  // 6\n",
    "    (-20  10  8)  // 7\n",
    ");\n",
    "blocks ( hex (0 1 2 3 4 5 6 7) (60 20 8) simpleGrading (1 1 1) );\n",
    "edges ();\n",
    "boundary\n",
    "(\n",
    "    inlet  { type patch; faces ((0 4 7 3)); }\n",
    "    outlet { type patch; faces ((1 2 6 5)); }\n",
    "    sides  { type symmetryPlane; faces ((0 1 5 4)(3 7 6 2)); }\n",
    "    top    { type symmetryPlane; faces ((4 5 6 7)); }\n",
    "    ground { type wall; faces ((0 3 2 1)); }\n",
    ");\n",
    "\"\"\")\n",
    "\n",
    "    # --- snappyHexMeshDict ---\n",
    "    (case_dir / 'system' / 'snappyHexMeshDict').write_text(\"\"\"\\\n",
    "FoamFile { version 2.0; format ascii; class dictionary; object snappyHexMeshDict; }\n",
    "castellatedMesh true;\n",
    "snap            true;\n",
    "addLayers       false;\n",
    "geometry\n",
    "{\n",
    "    car.stl { type triSurfaceMesh; name car; }\n",
    "}\n",
    "castellatedMeshControls\n",
    "{\n",
    "    maxLocalCells     1000000;\n",
    "    maxGlobalCells    2000000;\n",
    "    minRefinementCells 0;\n",
    "    nCellsBetweenLevels 3;\n",
    "    features ();\n",
    "    refinementSurfaces { car { level (4 5); patchInfo { type wall; } } }\n",
    "    refinementRegions  {}\n",
    "    locationInMesh (5 0 1);\n",
    "    allowFreeStandingZoneFaces false;\n",
    "}\n",
    "snapControls\n",
    "{\n",
    "    nSmoothPatch     3;\n",
    "    tolerance        4.0;\n",
    "    nSolveIter       30;\n",
    "    nRelaxIter       5;\n",
    "    nFeatureSnapIter 10;\n",
    "    implicitFeatureSnap false;\n",
    "    explicitFeatureSnap true;\n",
    "    multiRegionFeatureSnap false;\n",
    "}\n",
    "addLayersControls { relativeSizes true; layers {} expansionRatio 1.0; finalLayerThickness 0.3; minThickness 0.1; }\n",
    "meshQualityControls { maxNonOrtho 65; maxBoundarySkewness 20; maxInternalSkewness 4; maxConcave 80; minVol 1e-13; minTetQuality -1e30; minArea -1; minTwist 0.01; minDeterminant 0.001; minFaceWeight 0.05; minVolRatio 0.01; minTriangleTwist -1; nSmoothScale 4; errorReduction 0.75; }\n",
    "writeFlags ( scalarLevels layerSets layerFields );\n",
    "mergeTolerance 1e-6;\n",
    "\"\"\")\n",
    "\n",
    "    # --- transportProperties ---\n",
    "    (case_dir / 'constant' / 'transportProperties').write_text(\"\"\"\\\n",
    "FoamFile { version 2.0; format ascii; class dictionary; object transportProperties; }\n",
    "transportModel Newtonian;\n",
    "nu  1.5e-05;  // kinematic viscosity of air at ~25C\n",
    "\"\"\")\n",
    "\n",
    "    # --- turbulenceProperties (k-omega SST) ---\n",
    "    (case_dir / 'constant' / 'turbulenceProperties').write_text(\"\"\"\\\n",
    "FoamFile { version 2.0; format ascii; class dictionary; object turbulenceProperties; }\n",
    "simulationType RAS;\n",
    "RAS { RASModel kOmegaSST; turbulence on; printCoeffs on; }\n",
    "\"\"\")\n",
    "\n",
    "    # Flow speed 60 m/s (~216 km/h, typical medium-speed corner)\n",
    "    U = 60.0\n",
    "\n",
    "    # --- 0/U ---\n",
    "    (case_dir / '0' / 'U').write_text(f\"\"\"\\\n",
    "FoamFile {{ version 2.0; format ascii; class volVectorField; object U; }}\n",
    "dimensions [0 1 -1 0 0 0 0];\n",
    "internalField uniform ({U} 0 0);\n",
    "boundaryField\n",
    "{{\n",
    "    inlet   {{ type fixedValue; value uniform ({U} 0 0); }}\n",
    "    outlet  {{ type zeroGradient; }}\n",
    "    sides   {{ type symmetryPlane; }}\n",
    "    top     {{ type symmetryPlane; }}\n",
    "    ground  {{ type fixedValue; value uniform ({U} 0 0); }}  // moving ground\n",
    "    car     {{ type noSlip; }}\n",
    "}}\n",
    "\"\"\")\n",
    "\n",
    "    # --- 0/p ---\n",
    "    (case_dir / '0' / 'p').write_text(\"\"\"\\\n",
    "FoamFile { version 2.0; format ascii; class volScalarField; object p; }\n",
    "dimensions [0 2 -2 0 0 0 0];\n",
    "internalField uniform 0;\n",
    "boundaryField\n",
    "{\n",
    "    inlet   { type zeroGradient; }\n",
    "    outlet  { type fixedValue; value uniform 0; }\n",
    "    sides   { type symmetryPlane; }\n",
    "    top     { type symmetryPlane; }\n",
    "    ground  { type zeroGradient; }\n",
    "    car     { type zeroGradient; }\n",
    "}\n",
    "\"\"\")\n",
    "\n",
    "    # --- 0/k ---\n",
    "    # Turbulent kinetic energy: k = 1.5*(U*I)^2, I=0.01 (1% turbulence intensity)\n",
    "    k_val = 1.5 * (U * 0.01) ** 2\n",
    "    (case_dir / '0' / 'k').write_text(f\"\"\"\\\n",
    "FoamFile {{ version 2.0; format ascii; class volScalarField; object k; }}\n",
    "dimensions [0 2 -2 0 0 0 0];\n",
    "internalField uniform {k_val:.4f};\n",
    "boundaryField\n",
    "{{\n",
    "    inlet   {{ type fixedValue; value uniform {k_val:.4f}; }}\n",
    "    outlet  {{ type zeroGradient; }}\n",
    "    sides   {{ type symmetryPlane; }}\n",
    "    top     {{ type symmetryPlane; }}\n",
    "    ground  {{ type zeroGradient; }}\n",
    "    car     {{ type kqRWallFunction; value uniform {k_val:.4f}; }}\n",
    "}}\n",
    "\"\"\")\n",
    "\n",
    "    # --- 0/omega ---\n",
    "    # Specific dissipation rate: omega = sqrt(k) / (Cmu^0.25 * L), L~0.1m\n",
    "    import math\n",
    "    omega_val = math.sqrt(k_val) / (0.09**0.25 * 0.1)\n",
    "    (case_dir / '0' / 'omega').write_text(f\"\"\"\\\n",
    "FoamFile {{ version 2.0; format ascii; class volScalarField; object omega; }}\n",
    "dimensions [0 0 -1 0 0 0 0];\n",
    "internalField uniform {omega_val:.2f};\n",
    "boundaryField\n",
    "{{\n",
    "    inlet   {{ type fixedValue; value uniform {omega_val:.2f}; }}\n",
    "    outlet  {{ type zeroGradient; }}\n",
    "    sides   {{ type symmetryPlane; }}\n",
    "    top     {{ type symmetryPlane; }}\n",
    "    ground  {{ type zeroGradient; }}\n",
    "    car     {{ type omegaWallFunction; value uniform {omega_val:.2f}; }}\n",
    "}}\n",
    "\"\"\")\n",
    "\n",
    "    # --- 0/nut ---\n",
    "    (case_dir / '0' / 'nut').write_text(\"\"\"\\\n",
    "FoamFile { version 2.0; format ascii; class volScalarField; object nut; }\n",
    "dimensions [0 2 -1 0 0 0 0];\n",
    "internalField uniform 0;\n",
    "boundaryField\n",
    "{\n",
    "    inlet   { type calculated; value uniform 0; }\n",
    "    outlet  { type calculated; value uniform 0; }\n",
    "    sides   { type symmetryPlane; }\n",
    "    top     { type symmetryPlane; }\n",
    "    ground  { type nutkWallFunction; value uniform 0; }\n",
    "    car     { type nutkWallFunction; value uniform 0; }\n",
    "}\n",
    "\"\"\")\n",
    "\n",
    "    # --- system/controlDict ---\n",
    "    (case_dir / 'system' / 'controlDict').write_text(\"\"\"\\\n",
    "FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }\n",
    "application     simpleFoam;\n",
    "startFrom       startTime;\n",
    "startTime       0;\n",
    "stopAt          endTime;\n",
    "endTime         300;\n",
    "deltaT          1;\n",
    "writeControl    timeStep;\n",
    "writeInterval   300;\n",
    "purgeWrite      1;\n",
    "writeFormat     ascii;\n",
    "writePrecision  6;\n",
    "writeCompression off;\n",
    "timeFormat      general;\n",
    "timePrecision   6;\n",
    "runTimeModifiable true;\n",
    "functions\n",
    "{\n",
    "    forceCoeffs\n",
    "    {\n",
    "        type            forceCoeffs;\n",
    "        libs            (forces);\n",
    "        writeControl    timeStep;\n",
    "        writeInterval   10;\n",
    "        patches         (car);\n",
    "        rho             rhoInf;\n",
    "        rhoInf          1.225;\n",
    "        liftDir         (0 0 1);\n",
    "        dragDir         (1 0 0);\n",
    "        CofR            (2.5 0 0.3);\n",
    "        pitchAxis       (0 1 0);\n",
    "        magUInf         60;\n",
    "        lRef            5.6;\n",
    "        Aref            1.5;\n",
    "    }\n",
    "}\n",
    "\"\"\")\n",
    "\n",
    "    # --- system/fvSchemes ---\n",
    "    (case_dir / 'system' / 'fvSchemes').write_text(\"\"\"\\\n",
    "FoamFile { version 2.0; format ascii; class dictionary; object fvSchemes; }\n",
    "ddtSchemes   { default steadyState; }\n",
    "gradSchemes  { default Gauss linear; }\n",
    "divSchemes\n",
    "{\n",
    "    default         none;\n",
    "    div(phi,U)      bounded Gauss linearUpwind grad(U);\n",
    "    div(phi,k)      bounded Gauss linearUpwind grad(k);\n",
    "    div(phi,omega)  bounded Gauss linearUpwind grad(omega);\n",
    "    div((nuEff*dev(T(grad(U))))) Gauss linear;\n",
    "}\n",
    "laplacianSchemes { default Gauss linear corrected; }\n",
    "interpolationSchemes { default linear; }\n",
    "snGradSchemes { default corrected; }\n",
    "\"\"\")\n",
    "\n",
    "    # --- system/fvSolution ---\n",
    "    (case_dir / 'system' / 'fvSolution').write_text(\"\"\"\\\n",
    "FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }\n",
    "solvers\n",
    "{\n",
    "    p   { solver GAMG; smoother GaussSeidel; tolerance 1e-6; relTol 0.1; }\n",
    "    U   { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-6; relTol 0.1; }\n",
    "    k   { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-6; relTol 0.1; }\n",
    "    omega { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-6; relTol 0.1; }\n",
    "}\n",
    "SIMPLE\n",
    "{\n",
    "    nNonOrthogonalCorrectors 1;\n",
    "    consistent yes;\n",
    "    residualControl { p 1e-4; U 1e-4; k 1e-4; omega 1e-4; }\n",
    "}\n",
    "relaxationFactors { fields { p 0.3; } equations { U 0.7; k 0.7; omega 0.7; } }\n",
    "\"\"\")\n",
    "\n",
    "    print(f'  Case written to {case_dir}')\n",
    "\n",
    "\n",
    "def parse_force_coeffs(case_dir: Path) -> dict:\n",
    "    \"\"\"Extract final CL and CD from OpenFOAM forceCoeffs output.\"\"\"\n",
    "    coeff_file = case_dir / 'postProcessing' / 'forceCoeffs' / '0' / 'coefficient.dat'\n",
    "    if not coeff_file.exists():\n",
    "        raise FileNotFoundError(f'No coefficient file at {coeff_file}')\n",
    "    last = None\n",
    "    with coeff_file.open() as f:\n",
    "        for line in f:\n",
    "            line = line.strip()\n",
    "            if line.startswith('#') or not line:\n",
    "                continue\n",
    "            parts = line.split()\n",
    "            if len(parts) >= 4:\n",
    "                try:\n",
    "                    last = {'cm': float(parts[1]), 'cd': float(parts[2]), 'cl': float(parts[3])}\n",
    "                except ValueError:\n",
    "                    pass\n",
    "    if last is None:\n",
    "        raise ValueError('No valid force coefficient data found')\n",
    "    cd = max(last['cd'], 0.001)\n",
    "    last['score'] = last['cl'] / cd\n",
    "    return last\n",
    "\n",
    "\n",
    "print('Case setup functions ready.')"
   ]
  },
  {
